# Copy to fastlane/.env.default (git-ignored) and fill in real values.
# fastlane auto-loads .env.default for every lane.
#
# App Store Connect API key — create one at
# App Store Connect > Users and Access > Integrations > App Store Connect API.
# Give it the "App Manager" role. Download the .p8 ONCE and store it outside the
# repo, e.g. ~/.config/c2k/AuthKey_XXXXXXXXXX.p8.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=/Users/you/.config/c2k/AuthKey_XXXXXXXXXX.p8

# Optional: only needed if a lane falls back to Apple-ID auth.
# FASTLANE_APPLE_ID=you@example.com
