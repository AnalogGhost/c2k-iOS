# fastlane snapshot configuration — App Store screenshots.
# Run with: bundle exec fastlane screenshots

# App is iPhone-only (TARGETED_DEVICE_FAMILY "1"). Apple requires only the
# largest iPhone display (6.9"); any 6.9" device produces 1320x2868 shots.
devices([
  "iPhone 16 Pro Max"
])

# App Store Connect has no Galician (gl) storefront, so store copy/screenshots
# stop at these six even though the app itself ships 7 languages.
languages([
  "en-US",
  "de-DE",
  "es-ES",
  "fr-FR",
  "pt-BR",
  "ru"
])

scheme("CtoKUITests")

# Raw captures. The `screenshots` lane then composites the framed/captioned
# marketing set into ./fastlane/screenshots/framed, which is what deliver uploads.
output_directory("./fastlane/screenshots/raw")
clear_previous_screenshots(true)
concurrent_simulators(true)

# Clean 9:41 / full-battery / full-signal status bar on every shot.
override_status_bar(true)

# Fail fast while the walkthrough is being stabilised.
stop_after_first_error(true)

# The screenshot walkthrough is the only test in this scheme's UI test target.
only_testing(["CtoKUITests/ScreenshotTests"])
