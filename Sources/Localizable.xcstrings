          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Segue, podes con isto!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue, você consegue!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте, вы справитесь!"
          }
        }
      }
    },
    "tts_encouragement_4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Great effort, nearly there!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starke Leistung, du bist fast da!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Buen esfuerzo, ya casi!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bel effort, vous y êtes presque !"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Bo esforzo, xa case!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ótimo esforço, já quase lá!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы молодец, уже почти у цели!"
          }
        }
      }
    },
    "tts_encouragement_5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're doing brilliantly, keep pushing!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du machst das hervorragend, gib weiter Gas!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Lo estás haciendo de maravilla, sigue empujando!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes brillant, continuez à pousser !"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Estás facéndoo brillantemente, segue empuxando!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está indo muito bem, continue se esforçando!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Великолепный прогресс, не останавливайтесь!"
          }
        }
      }
    },
    "coaching_c25k_w1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run at a pace where you can still talk. The walk breaks are part of the training."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lauf in einem Tempo, in dem du dich noch unterhalten kannst. Die Gehpausen sind Teil des Trainings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre a un ritmo conversacional. Los segmentos caminando son parte del entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Courez à une allure qui vous permet encore de parler. Les pauses marche font partie de l'entraînement."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Corre a un ritmo que che permita falar. As pausas camiñando son parte do adestramento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corra em um ritmo em que você ainda consiga conversar. As pausas de caminhada fazem parte do treino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бегите в таком темпе, чтобы вы могли спокойно разговаривать. Перерывы с ходьбой являются частью тренировки."
          }
        }
      }
    },
    "coaching_c25k_w2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You made it through week 1 — your body is already adapting. Keep the pace easy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Woche 1 geschafft – dein Körper passt sich bereits an. Halte das Tempo locker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has completado la primera semana — tu cuerpo ya se está adaptando. Continúa con suavidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez passé la semaine 1 — votre corps s'adapte déjà. Gardez une allure facile."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Completaches a primeira semana — o teu corpo xa se vai adaptando. Mantén o ritmo fácil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você passou pela semana 1 — seu corpo já está se adaptando. Mantenha o ritmo tranquilo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы справились с первой неделей — ваше тело уже адаптируется. Сохраняйте спокойный темп."
          }
        }
      }
    },
    "coaching_c25k_w3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Longer intervals this week. Focus on steady breathing: in for 2 steps, out for 2."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Woche gibt es längere Intervalle. Achte auf gleichmäßiges Atmen: 2 Schritte ein, 2 Schritte aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana tocan intervalos más largos. Concéntrate en una respiración relajada: inspira cada 2 pasos; expira cada otros 2."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des intervalles plus longs cette semaine. Concentrez-vous sur une respiration régulière : inspirez sur 2 pas, expirez sur 2 pas."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana intervalos máis longos. Céntrate na respiración: inhala cada 2 pasos; exhala cada 2."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalos mais longos esta semana. Foque em uma respiração constante: inspire em 2 passos, expire em 2."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более продолжительные интервалы на этой неделе. Сфокусируйтесь на размеренном дыхании: вдох на 2 шага, выдох на 2 шага."
          }
        }
      }
    },
    "coaching_c25k_w4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four different run lengths today. This builds mental toughness as much as fitness."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute vier verschiedene Laufabschnitte. Das stärkt genauso die mentale Stärke wie die Fitness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy cuatro distancias diferentes. Así creas fortaleza mental y también fitness."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre longueurs de course différentes aujourd'hui. Cela renforce autant la résistance mentale que la forme physique."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Catro lonxitudes diferentes hoxe. Isto contribúe á fortaleza mental tanto como á física."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro distâncias de corrida diferentes hoje. Isso constrói tanto força mental quanto condicionamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Четыре разных дистанции сегодня. Это укрепляет силу воли вместе с вашим телом."
          }
        }
      }
    },
    "coaching_c25k_w5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day 3 this week is the famous milestone: 20 minutes of continuous running. You've earned it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tag 3 dieser Woche ist der berühmte Meilenstein: 20 Minuten durchgehendes Laufen. Du hast es dir verdient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día 3 de esta semana es hito famoso: 20 minutos de carrera continua. Te lo as ganado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jour 3 de cette semaine est le fameux jalon : 20 minutes de course continue. Vous l'avez mérité."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O día 3 desta semana é un fito no camiño: 20 minutos de carreira contínua. Conseguíchelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia 3 desta semana é o famoso marco: 20 minutos de corrida contínua. Você mereceu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "День 3 на этой неделе знаменательный: 20 минут непрерывного бега. Вы это заслужили."
          }
        }
      }
    },
    "coaching_c25k_w6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're over the halfway mark. The long runs are building your aerobic base."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist über der Halbzeitmarke. Die langen Läufe bauen deine aerobe Basis auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has llegado a la mitad del camino. Los entrenamientos largos construyen tu base aeróbica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez passé la moitié du parcours. Les longues courses construisent votre base aérobie."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Superaches a metade do camiño. As carreiras longas crean a túa base aeróbica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você passou da metade. As corridas mais longas estão construindo sua base aeróbica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы более чем на полпути. Продолжительные забеги увеличиваются вашу аэробную силу."
          }
        }
      }
    },
    "coaching_c25k_w7": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "25 minutes continuous. Not everyone gets this far — you're a runner now."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "25 Minuten durchgehend. Nicht jeder kommt so weit – du bist jetzt ein Läufer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "25 minutos sin paus. No todo el mundo llega tan lejos — ya eres una persona corredora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "25 minutes en continu. Tout le monde ne va pas aussi loin — vous êtes maintenant un coureur."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "25 minutos seguidos. Non todo o mundo chega tan lonxe — xa es unha persoa corredora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "25 minutos contínuos. Nem todo mundo chega tão longe — agora você é um corredor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "25 минут непрерывности. Не каждый может достичь такого — теперь вы бегун."
          }
        }
      }
    },
    "coaching_c25k_w8": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "28 minutes. The goal is almost in reach. Don't speed up — save it for next week."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "28 Minuten. Das Ziel ist fast erreicht. Werde nicht schneller – heb dir das für nächste Woche auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "28 minutos. El objetivo está a tu alcance. No aceleres — guárdatelo para la próxima semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "28 minutes. L'objectif est presque atteint. N'accélérez pas — gardez-en pour la semaine prochaine."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "28 minutos. Xa case conseguiches o obxectivo. Non te apresures, gárdao para a próxima semana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
