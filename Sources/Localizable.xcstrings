    "Fix: TTS announcements now duck background music instead of pausing it": {
      "extractionState": "manual",
      "comment": "Android credit; iOS ducking was implemented independently this session, not ported from Android — used only if attribution is restored, see task notes",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix: Sprachansagen dämpfen jetzt die Hintergrundmusik, statt sie zu pausieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrección: los anuncios de voz ahora atenúan la música de fondo en lugar de pausarla"
          }
        },
        "fr": {
