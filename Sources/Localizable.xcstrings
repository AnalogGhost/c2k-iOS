    "This will permanently remove all completed sessions for this program. Your overall history is kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle abgeschlossenen Sitzungen für dieses Programm dauerhaft gelöscht. Dein gesamter Verlauf bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con esto vas a eliminar todas las sesiones del programa que has completado. El historial general se mantiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprimera définitivement toutes les séances terminées de ce programme. Votre historique global est conservé."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Con isto vas eliminar todas as sesións completadas para o programa, pero o historial xeral vaise manter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso removerá permanentemente todas as sessões concluídas deste programa. Seu histórico geral será mantido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полностью удалить весь прогресс завершённых сессий для этой программы. Ваша общая история будет сохранена."
          }
        }
      }
    },
