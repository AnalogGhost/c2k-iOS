    "tts_encouragement_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're doing great, keep it up!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du machst das großartig, weiter so!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Lo estás haciendo genial, sigue así!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous vous en sortez très bien, continuez !"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Estás indo de marabilla, continúa así!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está indo muito bem, continue assim!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас отлично получается, продолжайте!"
          }
        }
      }
    },
    "tts_encouragement_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Halfway through, stay strong!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon zur Hälfte geschafft, bleib stark!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡A mitad de camino, mantente fuerte!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À mi-chemin, restez fort !"
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "¡A metade do camiño, mantente forte!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na metade do caminho, mantenha-se firme!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже на полпути, не сдавайтесь!"
          }
        }
      }
    },
    "tts_encouragement_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep going, you've got this!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter so, du schaffst das!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Sigue, tú puedes!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
